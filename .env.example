# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=restaurant_system
DATABASE_URL="postgresql://restaurant_user:restaurant_password@localhost:5432/restaurant_system"

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

ADMIN_NAME="replace-with-admin-name"
ADMIN_EMAIL="replace-with-admin-email"
ADMIN_PASSWORD="replace-with-admin-password"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Restaurant System <no-reply@restaurant.local>"
FRONTEND_URL="http://localhost:3001"