# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=restaurant_system
DATABASE_URL="postgresql://restaurant_user:restaurant_password@localhost:5432/restaurant_system"

NODE_ENV=development

JWT_ACCESS_SECRET="replace-with-a-long-random-string"
JWT_ACCESS_EXPIRES_IN="1h"

ADMIN_NAME="replace-with-admin-name"
ADMIN_EMAIL="replace-with-admin-email"
ADMIN_PASSWORD="replace-with-admin-password"

SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Restaurant System <no-reply@restaurant.local>"
FRONTEND_URL="http://localhost:3001"

TRUST_PROXY_HOPS=0

# IANA time zone of this deployment (required). Used for scheduled jobs and,
# later, business-day boundaries. Palestine: Asia/Hebron, Doha: Asia/Qatar.
APP_TIMEZONE=Asia/Hebron

# When to delete refresh tokens expired > 1 day ago (optional, in APP_TIMEZONE).
# Default: daily at 04:00.
REFRESH_TOKEN_CLEANUP_CRON="0 4 * * *"