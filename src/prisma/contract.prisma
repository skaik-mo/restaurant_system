// use prisma-8
enum UserRole {
  ADMIN
  KITCHEN
  WAITER
}

model User {
  id                         Int                        @id @default(autoincrement())
  name                       String
  email                      String                     @unique
  password                   String
  role                       UserRole
  mustChangePassword         Boolean                    @default(true)
  emailVerified              Boolean                    @default(false)
  emailVerificationToken     String?
  emailVerificationExpiresAt TimestamptzString?
  passwordResetToken         String?
  passwordResetExpiresAt     TimestamptzString?
  orders                     Order[]
  refreshTokens              RefreshToken[]
  createdAt                  TimestamptzString          @default(now())
  updatedAt                  temporal.updatedAtString()
}

model RefreshToken {
  id        Int               @id @default(autoincrement())
  tokenHash String
  expiresAt TimestamptzString
  revoked   Boolean           @default(false)
  userId    Int
  user      User              @relation(fields:[userId], references:[id], onDelete: Cascade)
  createdAt TimestamptzString @default(now())
}

model Category {
  id        Int                        @id @default(autoincrement())
  name      String
  sortOrder Int                        @default(0)
  menuItems MenuItem[]
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()

  @@index(expression: "lower(name)", unique: true, name: "category_name_lower")
}

model MenuItem {
  id          Int                        @id @default(autoincrement())
  name        String
  description String?
  price       Numeric(10, 2)
  imageUrl    String?
  sortOrder   Int                        @default(0)
  isAvailable Boolean                    @default(true)
  categoryId  Int
  category    Category                   @relation(fields:[categoryId], references:[id])
  orderItems  OrderItem[]
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}

enum TableStatus {
  AVAILABLE
  BUSY
}

model DiningTable {
  id               Int                        @id @default(autoincrement())
  number           Int                        @unique
  status           TableStatus                @default(AVAILABLE)
  qrToken          String                     @unique
  qrTokenRotatedAt TimestamptzString          @default(now())
  orders           Order[]
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()
}

enum OrderSource {
  QR_TABLE
  WAITER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

model Order {
  id                   Int                        @id @default(autoincrement())
  customerName         String?
  source               OrderSource
  type                 OrderType
  totalPrice           Numeric(10, 2)
  orderAccessTokenHash String?                    @unique
  userId               Int?
  user                 User?                      @relation(fields:[userId], references:[id])
  tableId              Int?
  table                DiningTable?               @relation(fields:[tableId], references:[id])
  items                OrderItem[]
  status               OrderStatus                @default(PENDING)
  createdAt            TimestamptzString          @default(now())
  updatedAt            temporal.updatedAtString()
}

model OrderItem {
  id               Int                        @id @default(autoincrement())
  itemName         String
  quantity         Int
  priceAtOrderTime Numeric(10, 2)
  orderId          Int
  order            Order                      @relation(fields:[orderId], references:[id])
  menuItemId       Int?
  menuItem         MenuItem?                  @relation(fields:[menuItemId], references:[id], onDelete: SetNull)
  createdAt        TimestamptzString          @default(now())
  updatedAt        temporal.updatedAtString()
}
