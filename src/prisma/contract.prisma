// use prisma-8

enum UserRole {
  ADMIN
  KITCHEN
  WAITER
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      UserRole
  orders    Order[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  menuItems MenuItem[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model MenuItem {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Decimal
  imageUrl   String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

enum TableStatus {
  AVAILABLE
  BUSY
}

model Table {
  id        Int      @id @default(autoincrement())
  number    Int      @unique
  status    TableStatus @default(AVAILABLE)
  orders    Order[]
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

enum OrderSource {
  QR_TABLE
  WAITER
}

enum OrderType {
  DINE_IN
  TAKEAWAY
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  CANCELLED
}

model Order {
  id          Int        @id @default(autoincrement())
  customerName String?
  source      OrderSource
  type        OrderType
  totalPrice  Decimal
  userId      Int?
  user        User?      @relation(fields: [userId], references: [id])
  tableId     Int?
  table       Table?      @relation(fields: [tableId], references: [id])
  items       OrderItem[]
  status      OrderStatus @default(PENDING)
  createdAt   TimestamptzString   @default(now())
  updatedAt   temporal.updatedAtString()
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  quantity  Int
  priceAtOrderTime Decimal  
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  menuItemId Int
  menuItem  MenuItem @relation(fields: [menuItemId], references: [id])
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}
